---
import { getTranslations } from "../i18n/index.js";
import Intro from "./Intro.astro";

const { locale = "pl" } = Astro.props;
const t = getTranslations(locale);
const otherLocale = locale === "en" ? "pl" : "en";
const otherHref = otherLocale === "en" ? "/en/" : "/";
const otherLabel = otherLocale === "en" ? "EN" : "PL";
const privacyHref = locale === "en" ? "/en/privacy/" : "/prywatnosc/";
const tel = t.phone.replace(/\s/g, "");
const railClass = "aa-rev aa-rise text-[11px] uppercase tracking-[0.18em] text-ink-3";
---

<!-- Terminal register: everything is mono, the copy sits between a prompt
     line and a waiting block cursor, and 16px / 1.6 echoes the Ghostty
     config's font-size 16 with adjust-cell-height 12%. -->
<Intro />

<div class="relative z-10 flex min-h-svh flex-col px-6 py-6 font-mono md:px-10 md:py-8 lg:px-16">
  <!-- One column governs every edge: the controls, the name and the footer
       link all start and end on the same two axes. -->
  <div class="mx-auto flex w-full max-w-[1100px] flex-1 flex-col">
    <header class="flex items-center justify-end gap-6">
      <a
        href={otherHref}
        hreflang={otherLocale}
        class={railClass}
        data-label={otherLabel}
        style="animation-delay: calc(var(--rise-base, 0s) + 0.52s)"
      >{otherLabel}</a>

      <button
        id="theme-toggle"
        type="button"
        aria-label={t.theme_l}
        class="aa-rev aa-rise -mx-1.5 -my-1.5 p-1.5 text-ink-3"
        style="animation-delay: calc(var(--rise-base, 0s) + 0.58s)"
      >
        <svg viewBox="0 0 20 20" class="only-dark h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4" />
          <path d="M10 2.4v1.8M10 15.8v1.8M17.6 10h-1.8M4.2 10H2.4M15.37 4.63l-1.27 1.27M5.9 14.1l-1.27 1.27M15.37 15.37l-1.27-1.27M5.9 5.9L4.63 4.63" />
        </svg>
        <svg viewBox="0 0 20 20" class="only-light h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1Z" />
        </svg>
      </button>
    </header>

    <main class="flex flex-1 items-center">
      <div id="aa-home" class="max-w-[620px]">
        <!-- The wordmark is the monogram written out: letter, accent dot,
             letter. The three spans are also what the intro lands on, so it
             measures real glyph boxes instead of counting characters. The
             aria-label keeps the spoken name a name, not "Adrian dot". -->
        <h1
          aria-label="Adrian Antosiak"
          class="aa-rise text-[clamp(28px,6.2vw,52px)] font-bold leading-[1.1] text-ink"
          style="animation-delay: calc(var(--rise-base, 0s) + 0.16s)"
        ><span data-glyph="a1">A</span>drian<span data-glyph="dot" class="text-accent">.</span><span data-glyph="a2">A</span>ntosiak</h1>

        <p
          class="aa-rise mt-4 text-[15px] leading-[1.6] text-ink-2 md:text-[16px]"
          style="animation-delay: calc(var(--rise-base, 0s) + 0.28s)"
        >
          {t.lead}<span class="aa-cursor ml-1.5" aria-hidden="true"></span>
        </p>

        <div class="aa-rise mt-10 flex flex-col items-start gap-1.5" style="animation-delay: calc(var(--rise-base, 0s) + 0.4s)">
          <a
            href={`mailto:${t.email_addr}`}
            data-label={t.email_addr}
            class="aa-rev text-[15px] leading-[1.6] text-ink underline decoration-line underline-offset-[5px] md:text-[16px]"
          >
            {t.email_addr}
          </a>
          <a
            href={`tel:${tel}`}
            data-label={t.phone}
            class="aa-rev text-[15px] leading-[1.6] text-ink-3 underline decoration-transparent underline-offset-[5px] md:text-[16px]"
          >
            {t.phone}
          </a>
        </div>
      </div>

      <!-- The page does not scroll, so a scroll attempt is the one thing left
           to do. It gets the old cartoon ending: the copy swaps for a title
           card in the same spot, the chrome stays put. Scrolling back up (or
           Escape) brings the page back. -->
      <div id="aa-end" class="aa-iris max-w-[620px]" hidden>
        <p
          class="aa-rise text-[clamp(28px,6.2vw,52px)] font-bold leading-[1.1] text-ink"
          style="animation-delay: 0.16s"
        >{t.end_title}<span class="text-accent">.</span></p>

        <p
          class="aa-rise mt-4 text-[15px] leading-[1.6] text-ink-2 md:text-[16px]"
          style="animation-delay: 0.28s"
        >{t.end_l}<br />{t.end_l2}</p>

        <div class="aa-rise mt-10 flex flex-col items-start gap-1.5" style="animation-delay: 0.4s">
          <a
            href={`mailto:${t.email_addr}`}
            data-label={t.email_addr}
            class="aa-rev text-[15px] leading-[1.6] text-ink underline decoration-line underline-offset-[5px] md:text-[16px]"
          >{t.email_addr}</a>
          <a
            href={`tel:${tel}`}
            data-label={t.phone}
            class="aa-rev text-[15px] leading-[1.6] text-ink-3 underline decoration-transparent underline-offset-[5px] md:text-[16px]"
          >{t.phone}</a>
        </div>
      </div>
    </main>

    <footer class="flex items-center justify-start">
      <a
        href={privacyHref}
        class={railClass}
        data-label={t.privacy_l}
        style="animation-delay: calc(var(--rise-base, 0s) + 0.64s)"
      >{t.privacy_l}</a>
    </footer>
  </div>
</div>


<script>
  // The pointer uncovers the terminal underneath the page: a buffer that is
  // still computing something - faint, meaningless punctuation sitting in
  // the same 9.6 x 24 character cells the intro assembles from, shown only
  // inside a soft circle that follows the cursor. While the layer is
  // visible, a few dozen cells around the pointer are rewritten every tick,
  // so the buffer keeps churning; the rest of the canvas is never touched.
  // A move writes two custom properties on rAF and touches no layout.
  // Pointer-only and motion-safe: touch and prefers-reduced-motion never see
  // it. The canvas is created here rather than in the markup: Astro's
  // compiler moves a <canvas>'s closing tag past whatever follows it, which
  // swallowed the whole page into the layer. Without JS there is no layer.
  const wants =
    window.matchMedia("(hover: hover)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (wants) {
    const grid = document.createElement("canvas");
    grid.className = "aa-grid";
    grid.setAttribute("aria-hidden", "true");
    document.body.prepend(grid);

    const CELL_W = 9.6;
    const CELL_H = 24;
    const GLYPHS = ".:-+/\\|_=*'`";
    const DENSITY = 0.55;
    // The mask fades out at 72% of 190px; churn a little past that.
    const RADIUS = 150;
    const TICK = 70;
    const CHURN = 36;
    let px = 0;
    let py = 0;
    let raf = 0;
    let ctx: CanvasRenderingContext2D | null = null;
    let cols = 0;
    let rows = 0;
    let visible = false;
    let last = 0;

    const cell = (c: number, r: number) => {
      if (!ctx || c < 0 || r < 0 || c >= cols || r >= rows) return;
      ctx.clearRect(c * CELL_W, r * CELL_H, CELL_W, CELL_H);
      if (Math.random() > DENSITY) return;
      const g = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      ctx.fillText(g, (c + 0.5) * CELL_W, (r + 0.5) * CELL_H);
    };

    const paint = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = window.innerWidth;
      const h = window.innerHeight;
      grid.width = Math.ceil(w * dpr);
      grid.height = Math.ceil(h * dpr);
      ctx = grid.getContext("2d");
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = getComputedStyle(grid).color;
      ctx.font = "16px 'JetBrains Mono', monospace";
      ctx.textBaseline = "middle";
      ctx.textAlign = "center";
      cols = Math.ceil(w / CELL_W);
      rows = Math.ceil(h / CELL_H);
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) cell(c, r);
    };

    const churn = () => {
      const rc = Math.ceil(RADIUS / CELL_W);
      const rr = Math.ceil(RADIUS / CELL_H);
      const cc = Math.floor(px / CELL_W);
      const cr = Math.floor(py / CELL_H);
      for (let i = 0; i < CHURN; i++) {
        cell(cc + Math.round((Math.random() * 2 - 1) * rc), cr + Math.round((Math.random() * 2 - 1) * rr));
      }
    };

    const frame = (t: number) => {
      raf = 0;
      grid.style.setProperty("--x", px + "px");
      grid.style.setProperty("--y", py + "px");
      if (t - last >= TICK) {
        last = t;
        churn();
      }
      if (visible) raf = requestAnimationFrame(frame);
    };

    document.fonts.ready.then(paint);
    window.addEventListener("resize", paint);
    new MutationObserver(paint).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType === "touch") return;
        px = e.clientX;
        py = e.clientY;
        if (!visible) {
          visible = true;
          grid.style.opacity = "1";
        }
        if (!raf) raf = requestAnimationFrame(frame);
      },
      { passive: true },
    );

    document.addEventListener("pointerleave", () => {
      visible = false;
      grid.style.opacity = "0";
    });
  }
</script>

<script>
  // Scroll intent flips between the page and the end card. Down (wheel,
  // swipe up, ArrowDown / PageDown / End / Space) closes the iris; up (or
  // Escape) opens it again. A short lock keeps one wheel gesture from
  // toggling twice.
  const home = document.getElementById("aa-home");
  const end = document.getElementById("aa-end");
  let lock = 0;

  function show(on) {
    if (!home || !end || end.hidden === !on) return;
    if (lock) return;
    // Coming back, the copy should not wait for an intro that already ran.
    home.style.setProperty("--rise-base", "0s");
    home.hidden = on;
    end.hidden = !on;
    lock = window.setTimeout(() => (lock = 0), 700);
  }

  window.addEventListener(
    "wheel",
    (e) => {
      if (Math.abs(e.deltaY) < 4) return;
      show(e.deltaY > 0);
    },
    { passive: true },
  );

  let touchY = 0;
  window.addEventListener("touchstart", (e) => (touchY = e.touches[0].clientY), { passive: true });
  window.addEventListener(
    "touchmove",
    (e) => {
      const d = touchY - e.touches[0].clientY;
      if (Math.abs(d) > 24) show(d > 0);
    },
    { passive: true },
  );

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") return show(false);
    if (e.target !== document.body && !end?.contains(e.target) && !home?.contains(e.target)) return;
    if (["ArrowDown", "PageDown", "End", " "].includes(e.key)) show(true);
    if (["ArrowUp", "PageUp", "Home"].includes(e.key)) show(false);
  });
</script>

<script>
  // Theme flip. The pre-paint script in Base.astro already resolved the
  // stored or system choice; this only swaps it, behind a circular wipe
  // growing from the control (MDN's reveal recipe). Keyboard activation
  // reports clientX/Y 0, so the origin falls back to the button's center.
  const btn = document.getElementById("theme-toggle");

  function apply(next) {
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("aa_theme", next);
    } catch (e) {}
    const m = document.querySelector('meta[name="theme-color"]');
    if (m) m.setAttribute("content", next === "light" ? "#eff1f5" : "#1e1e2e");
  }

  btn?.addEventListener("click", (e) => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce || !document.startViewTransition) {
      apply(next);
      return;
    }

    const r = btn.getBoundingClientRect();
    const x = e.clientX || r.left + r.width / 2;
    const y = e.clientY || r.top + r.height / 2;
    const reach = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    document.startViewTransition(() => apply(next)).ready.then(() => {
      document.documentElement.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${reach}px at ${x}px ${y}px)`] },
        { duration: 420, easing: "ease-in-out", pseudoElement: "::view-transition-new(root)" },
      );
    });
  });
</script>
