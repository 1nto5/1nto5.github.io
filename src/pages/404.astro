---
import "../styles/global.css";
// Single bilingual 404 - GitHub Pages serves /404.html for every missing
// path, so there is no per-locale variant.
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />
    <title>404 - Adrian Antosiak</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preload" href="/fonts/inter-tight-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Resolve the theme before first paint - same logic as Base.astro.
      (function () {
        var t = "dark";
        try {
          var s = localStorage.getItem("aa_theme");
          t =
            s === "light" || s === "dark"
              ? s
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute("content", t === "light" ? "#f4f5f7" : "#050505");
      })();
    </script>
  </head>
  <body>
    <main class="flex min-h-[100dvh] flex-col items-center justify-center px-6 text-center">
      <a href="/" aria-label="Adrian Antosiak" class="mb-6 text-ink/40 transition-colors duration-200 hover:text-ink">
        <svg viewBox="0 0 64 64" class="h-8 w-8" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M14 4 L1 60 L27 60 Z M14 18 L7 38 L21 38 Z" fill-rule="evenodd"></path>
          <rect x="30" y="52" width="4" height="8"></rect>
          <path d="M50 4 L37 60 L63 60 Z M50 18 L43 38 L57 38 Z" fill-rule="evenodd"></path>
        </svg>
      </a>
      <p class="font-mono text-[12px] uppercase tracking-[0.2em] text-ink-3">404</p>
      <h1 class="mt-4 text-[40px] font-semibold leading-[1.05] tracking-tight md:text-[56px]">
        Nie ma takiej strony.
      </h1>
      <p class="mt-4 max-w-[420px] text-[15px] leading-relaxed text-ink-2">
        Adres jest nieaktualny albo wkradła się literówka. / This page does not exist.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex min-h-11 items-center justify-center rounded-xl bg-ink px-6 py-2.5 text-[13px] font-medium text-bg transition duration-200 hover:-translate-y-0.5 hover:bg-ink/90 active:translate-y-0 active:scale-[0.98]"
        >
          Strona główna
        </a>
        <a
          href="/en/"
          hreflang="en"
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-line-2 px-6 py-2.5 text-[13px] font-medium text-ink transition duration-200 hover:-translate-y-0.5 hover:border-ink/50 active:translate-y-0 active:scale-[0.98]"
        >
          Home (EN)
        </a>
        <a
          href="mailto:czesc@adrianantosiak.pl"
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-line-2 px-6 py-2.5 text-[13px] font-medium text-ink transition duration-200 hover:-translate-y-0.5 hover:border-ink/50 active:translate-y-0 active:scale-[0.98]"
        >
          czesc@adrianantosiak.pl
        </a>
      </div>
    </main>
  </body>
</html>
