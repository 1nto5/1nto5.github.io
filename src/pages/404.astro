---
import "../styles/global.css";
// Single bilingual 404 - GitHub Pages serves /404.html for every missing
// path, so there is no per-locale variant.
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e1e2e" />
    <title>404 - Adrian Antosiak</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preload" href="/fonts/inter-tight-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Resolve the theme before first paint - same logic as Base.astro.
      (function () {
        var t = "dark";
        try {
          var s = localStorage.getItem("aa_theme");
          t =
            s === "light" || s === "dark"
              ? s
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute("content", t === "light" ? "#eff1f5" : "#1e1e2e");
      })();
    </script>
  </head>
  <body>
    <!-- Same register as the home page: mono, left-aligned, one screen, the
         same inverse-video links. Bilingual, because GitHub Pages serves this
         one file for every missing path in both locales. -->
    <div class="flex min-h-svh flex-col px-6 py-6 font-mono md:px-10 md:py-8 lg:px-16">
      <div class="mx-auto flex w-full max-w-[1100px] flex-1 flex-col">
        <main class="flex flex-1 items-center">
          <div class="max-w-[620px]">
            <p class="aa-rise text-[13px] leading-none text-ink-3" style="animation-delay: 0.05s">404</p>

            <h1 class="aa-rise mt-5 text-[clamp(28px,6.2vw,52px)] font-bold leading-[1.1] text-ink" style="animation-delay: 0.16s">
              Nie ma takiej strony
            </h1>

            <p class="aa-rise mt-4 text-[15px] leading-[1.6] text-ink-2 md:text-[16px]" style="animation-delay: 0.28s">
              Adres jest nieaktualny albo wkradła się literówka.<br />
              This page does not exist.<span class="aa-cursor ml-1.5" aria-hidden="true"></span>
            </p>

            <div class="aa-rise mt-10 flex flex-col items-start gap-1.5" style="animation-delay: 0.4s">
              <a
                href="/"
                data-label="strona główna"
                class="aa-rev text-[15px] leading-[1.6] text-ink underline decoration-line underline-offset-[5px] md:text-[16px]"
              >
                strona główna
              </a>
              <a
                href="/en/"
                hreflang="en"
                data-label="home (EN)"
                class="aa-rev text-[15px] leading-[1.6] text-ink underline decoration-line underline-offset-[5px] md:text-[16px]"
              >
                home (EN)
              </a>
              <a
                href="mailto:czesc@adrianantosiak.pl"
                data-label="czesc@adrianantosiak.pl"
                class="aa-rev text-[15px] leading-[1.6] text-ink-3 underline decoration-transparent underline-offset-[5px] md:text-[16px]"
              >
                czesc@adrianantosiak.pl
              </a>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
