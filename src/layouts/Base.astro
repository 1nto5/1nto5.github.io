---
import "../styles/global.css";
import { getMeta } from "../i18n/index.js";

const { locale = "pl", page = "home" } = Astro.props;
const meta = getMeta(locale, page);
const SITE = "https://adrianantosiak.pl";
const canonical = SITE + meta.path;
const ogImage = SITE + "/og.png";
const altPl = SITE + meta.altPaths.pl;
const altEn = SITE + meta.altPaths.en;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Adrian Antosiak",
  url: SITE + "/",
  knowsAbout: [
    "Artificial Intelligence",
    "Large Language Models",
    "ChatGPT for Business",
    "Business Process Automation",
    "Custom Software Development",
    "Web Applications",
    "Mobile Applications",
    "API Integration",
    "Website Development",
    "E-commerce",
  ],
  email: "mailto:kontakt@adrianantosiak.pl",
  telephone: "+48503751676",
  knowsLanguage: ["pl", "en"],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Adrian Antosiak",
  url: SITE + "/",
  inLanguage: ["pl-PL", "en-US"],
  publisher: { "@type": "Person", name: "Adrian Antosiak" },
};
---
<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050505" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={altPl} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altPl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Adrian Antosiak" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:locale:alternate" content={meta.ogLocaleAlternate} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <script is:inline>
      document.documentElement.classList.add("js-on");
    </script>
  </head>
  <body>
    <slot name="prerender" />
    <slot />
  </body>
</html>
